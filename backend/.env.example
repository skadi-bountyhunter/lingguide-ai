# 灵境导游后端环境变量配置示例
# 复制此文件为 backend/.env 并填入真实值

# 魔珐星云数字人
XVERSE_APP_ID=your_app_id_here
XVERSE_APP_SECRET=your_app_secret_here
XVERSE_APP_KEY=your_app_key_here

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 高德地图
AMAP_WEB_KEY=your_amap_web_key_here

# 腾讯云（可选，用于真实短信验证码）
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
